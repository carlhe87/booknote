# Bookmarks for the `j` function (see Microsoft.PowerShell_profile.ps1).
# Name = path. Folders -> cd there; files -> cd to their folder and open in nvim.
# Use %VAR% for environment variables so paths survive moving machines.
@{
    ps      = '%USERPROFILE%\Documents\WindowsPowerShell\Microsoft.PowerShell_profile.ps1'
    nvim    = '%LOCALAPPDATA%\nvim\init.lua'
    proj    = '%USERPROFILE%\proj'
    marks   = '%USERPROFILE%\Documents\WindowsPowerShell\bookmarks.psd1'
}
