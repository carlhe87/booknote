# This machine's bookmarks for the `j` function. Not tracked in git.
# Created from bookmarks-local-template.psd1 on first use; edit freely (`j marks`).
#
# Entries here are added to the shared ones in bookmarks.psd1. If a name is in
# both files, the entry here wins.
#
# Format: name = 'path', same as bookmarks.psd1. Uncomment the examples below
# and change the paths, or add your own.
# Use %VAR% for environment variables, e.g. %USERPROFILE%, %LOCALAPPDATA%.
@{
    # Folders: `j <name>` changes to the folder
    # proj    = '%USERPROFILE%\proj'
    # desktop = '%USERPROFILE%\Desktop'

    # Files: `j <name>` changes to the file's folder and opens the file
    # (text in nvim; docx, xlsx, pdf, images, ... in the default app)
    # todo    = '%USERPROFILE%\Documents\todo.org'

    # Override a shared bookmark, e.g. a different Downloads folder
    # downloads = 'D:\Downloads'
}
